    {
      "id": 15,
      "type": "timeseries",
      "title": "AI requests per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recipesage-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recipesage-postgres"
          },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(\"createdAt\", '1d', 0), CASE operation\n  WHEN 'clipHtml' THEN 'Import from URL'\n  WHEN 'clipUrl' THEN 'Import from URL (fetched)'\n  WHEN 'mlOcr' THEN 'Photo scan'\n  WHEN 'mlPdf' THEN 'PDF scan'\n  WHEN 'mlDocument' THEN 'Document scan'\n  WHEN 'mlTextRecipe' THEN 'Text to recipe'\n  WHEN 'mlTextNutrition' THEN 'Nutrition'\n  WHEN 'importUrls' THEN 'Bulk import: URLs'\n  WHEN 'importTextfiles' THEN 'Bulk import: text files'\n  WHEN 'importPdfs' THEN 'Bulk import: PDFs'\n  WHEN 'importImages' THEN 'Bulk import: images'\n  WHEN 'assistantMessage' THEN 'Assistant chat'\n  ELSE operation END AS metric, count(*) AS value FROM \"UserCreditLogs\" WHERE $__timeFilter(\"createdAt\") GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
