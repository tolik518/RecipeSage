      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recipesage-postgres"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT CASE operation\n  WHEN 'clipHtml' THEN 'Import from URL'\n  WHEN 'clipUrl' THEN 'Import from URL (fetched)'\n  WHEN 'mlOcr' THEN 'Photo scan'\n  WHEN 'mlPdf' THEN 'PDF scan'\n  WHEN 'mlDocument' THEN 'Document scan'\n  WHEN 'mlTextRecipe' THEN 'Text to recipe'\n  WHEN 'mlTextNutrition' THEN 'Nutrition'\n  WHEN 'importUrls' THEN 'Bulk import: URLs'\n  WHEN 'importTextfiles' THEN 'Bulk import: text files'\n  WHEN 'importPdfs' THEN 'Bulk import: PDFs'\n  WHEN 'importImages' THEN 'Bulk import: images'\n  WHEN 'assistantMessage' THEN 'Assistant chat'\n  ELSE operation END AS \"type\", count(*) AS \"requests\" FROM \"UserCreditLogs\" WHERE $__timeFilter(\"createdAt\") GROUP BY 1 ORDER BY 2 DESC"
        }
      ]
    },
