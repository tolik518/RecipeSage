# Copy to .env and set a strong value: `cp .env.example .env`
# NOTE: must match the password the postgres volume was first initialized with.
# Changing it later does not re-key an existing DB (needs a volume reset).
POSTGRES_PASSWORD=change_me

# --- AI (Anthropic API) -----------------------------------------------------
# Key from console.anthropic.com -> API Keys (starts with sk-ant-). Separate,
# prepaid billing; a claude.ai subscription does not cover it.
AI_API_KEY=

# All AI tasks default to Claude Opus 5.5 (best quality). To save money, use
# the much cheaper Claude Haiku 5.5 for the simple, high-volume tasks
# ("option B") by uncommenting these five lines:
#AI_MODEL_WEBPAGE=claude-haiku-5-5
#AI_MODEL_TEXT=claude-haiku-5-5
#AI_MODEL_NUTRITION=claude-haiku-5-5
#AI_MODEL_MODERATION=claude-haiku-5-5
#AI_MODEL_ASSISTANT_LOW=claude-haiku-5-5
